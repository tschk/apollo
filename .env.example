# apollo — required environment variables
# Copy this to .env and fill in your values

# AI provider API key (at least one required)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# Telegram channel (optional)
# TELEGRAM_BOT_TOKEN=

# Discord channel (optional)
# DISCORD_BOT_TOKEN=

# Web search (optional)
# PERPLEXITY_API_KEY=
# BRAVE_SEARCH_API_KEY=
