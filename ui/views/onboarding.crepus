# Onboarding chrome: a 2px progress line on the top edge, the current step
# and a quiet footer. No title bar. Every `{name}` is a local in
# `OnboardingView::render`.
div w-full h-full flex flex-col bg-[#09090b] text-[#d4d4d8] font-[Chivo_Mono] @keydown=on_key_down
  {progress}

  div flex-1 w-full flex flex-col items-center px-10 pt-14 pb-4 overflow-hidden
    div w-full max-w-160 flex flex-col gap-5
      div flex flex-col gap-2
        span text-2xl font-semibold text-[#fafafa]
          "{title}"
        span text-sm text-[#71717a] leading-relaxed
          "{lede}"
      {body}

  div h-14 w-full flex flex-row items-center px-10 gap-3 shrink-0
    if {can_back}
      button text-[#71717a] text-sm px-2 py-2 rounded-md hover:text-[#d4d4d8] @click=on_back
        "{back_label}"
    span flex-1 text-xs text-[#f87171]
      "{error}"
    span text-xs text-[#52525b]
      "{hint}"
    span text-xs text-[#3f3f46]
      "{counter}"
    button bg-[#fafafa] text-[#09090b] text-sm font-semibold px-5 py-2 rounded-md hover:bg-[#d4d4d8] @click=on_next
      "{next_label}"
