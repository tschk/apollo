# Step 3 — workspace folder.
div w-full flex flex-col gap-4
  div w-full flex flex-col gap-2
    span text-xs text-[#71717a]
      "workspace folder"
    div w-full flex flex-row gap-2 items-center
      div flex-1
        {workspace_field}
      button bg-[#18181b] border border-[#3f3f46] text-[#d4d4d8] text-sm px-4 py-2 rounded-md hover:bg-[#27272a] @click=on_browse
        "browse…"
    span text-xs text-[#52525b]
      "{workspace_note}"
  div w-full flex flex-col gap-2 p-4 rounded-lg border border-[#3f3f46] bg-[#18181b]
    span text-xs text-[#71717a]
      "apollo will write"
    span text-sm text-[#d4d4d8]
      "{config_preview}"
    span text-sm text-[#d4d4d8]
      "{env_preview}"
    span text-sm text-[#d4d4d8]
      "{memory_preview}"
