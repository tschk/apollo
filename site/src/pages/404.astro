---
const title = "Apollo — page not found";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="That page is not part of Apollo." />
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/styles/app.css" />
  </head>
  <body>
    <div class="site not-found">
      <div class="wrap">
        <p class="kicker">404</p>
        <h1 class="word" style="font-size: clamp(3rem, 10vw, 6rem)">not here</h1>
        <p class="lede"><a href="/">Back to Apollo</a></p>
      </div>
    </div>
  </body>
</html>
