{
  "name": "@tschk/apollo-site",
  "private": true,
  "version": "0.1.0",
  "description": "apollo.tsc.hk — local-first agent host. Svelte 5 on moonshine, deployed as a Cloudflare Worker with assets.",
  "type": "module",
  "scripts": {
    "build": "bun build.ts",
    "dev": "bun run build && bunx wrangler dev --port 8787",
    "preview": "bun run build && bun scripts/preview.ts",
    "deploy": "bun run build && bunx wrangler deploy",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@fontsource/chivo-mono": "5.2.8",
    "@tschk/moonshine": "0.4.1",
    "@tschk/moonshine-framework": "0.4.1",
    "@tschk/moonshine-server": "0.4.1",
    "lenis": "1.3.17",
    "motion": "12.23.24",
    "svelte": "5.46.4"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "19.2.14",
    "typescript": "5.9.3",
    "unocss": "66.7.5",
    "wrangler": "4.45.0"
  }
}
